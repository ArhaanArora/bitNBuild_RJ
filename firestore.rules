rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    function isRole(expectedRole) {
      return isAuthenticated() && request.auth.token.role == expectedRole;
    }

    // ── Users Collection: Server-Enforced Roles ───────────────────────────
    // Role is fixed at account creation and CANNOT be altered client-side.
    match /users/{uid} {
      // User can read their own profile; admins can read any profile
      allow read: if isOwner(uid) || isAdmin();

      // Account creation: role must be one of the recognized roles
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['email', 'role'])
                    && request.resource.data.role in ['candidate', 'recruiter', 'organizer']
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin');

      // Profile updates: user can update personal details, but ROLE IS IMMUTABLE from client!
      // Any attempt to modify the role field directly will be rejected by Firestore.
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;

      // Only administrators can change or re-assign user roles
      allow write: if isAdmin();
    }

    // ── Role Change Requests ──────────────────────────────────────────────
    // Users submit a request; only admins can approve or reject
    match /roleRequests/{requestId} {
      // User can read their own requests; admins can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Authenticated users can submit a pending request for themselves
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedRole in ['candidate', 'recruiter', 'organizer'];

      // Only admins can approve, reject, or modify requests
      allow update, delete: if isAdmin();
    }

    // ── Role-Gated Candidate Passports & Skills ───────────────────────────
    match /candidates/{candidateId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(candidateId) || isAdmin();
    }

    // ── Recruiter Only Workspace Data ─────────────────────────────────────
    match /recruiters/{recruiterId} {
      allow read, write: if (isOwner(recruiterId) && isRole('recruiter')) || isAdmin();
    }

    match /shortlists/{shortlistId} {
      allow read, write: if isRole('recruiter') || isAdmin();
    }

    // ── Organizer Only Workspace Data ─────────────────────────────────────
    match /organizers/{organizerId} {
      allow read, write: if (isOwner(organizerId) && isRole('organizer')) || isAdmin();
    }

    match /hackathons/{hackathonId} {
      allow read: if true; // Public listings
      allow create, update, delete: if isRole('organizer') || isAdmin();
    }

    // ── Audit Logs: Cryptographically Write-Once / Read by Admin ─────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }
  }
}
