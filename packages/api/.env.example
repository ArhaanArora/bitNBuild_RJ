# ==============================================================================
# SkillVerify Backend API Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `packages/api/.env` and configure your secrets.
# ==============================================================================

# Server Port (default 6970 or 4000)
PORT=6970

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed CORS client origin
CLIENT_ORIGIN=http://localhost:6969

# PostgreSQL Database Connection String (Neon, Supabase, or local Postgres)
# Example: postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Secrets for centralized role-based authentication (Min 32 characters each)
JWT_SECRET=your_secure_random_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_secure_random_jwt_refresh_secret_min_32_chars

# File uploads directory (temp dir used automatically in serverless/Vercel)
UPLOAD_DIR=./uploads

# OpenAI API (Optional: Question generation and answer rubric scoring)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# FIREBASE ADMIN / AUTH INTEGRATION (Optional backend sync)
# ------------------------------------------------------------------------------
# Firebase Project ID matching your client configuration
FIREBASE_PROJECT_ID=skillverify-platform

# Firebase Service Account Key (if using Firebase Admin SDK server-side token verification)
# Can be path to json file or base64-encoded string:
# FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
