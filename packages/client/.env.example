# ==============================================================================
# SkillVerify Client Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `packages/client/.env` and replace placeholders with your credentials.
#
# HOW TO GET YOUR FIREBASE CREDENTIALS:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select your project (e.g., `skillverify-platform`)
# 3. Go to Project Settings (Gear icon) -> General
# 4. Scroll down to "Your apps" section -> select your Web App (</>)
# 5. Under "SDK setup and configuration", select "Config"
# 6. Copy the values into the fields below:
# ==============================================================================

# API Base URL (Leave empty in production so it calls relative `/api` on Vercel)
# In local development: http://localhost:6970
VITE_API_URL=

# ------------------------------------------------------------------------------
# FIREBASE WEB CONFIGURATION (Required for Google & Email Authentication)
# ------------------------------------------------------------------------------
# Firebase Web API Key (e.g. AIzaSyDOx6O9VkBWsrz0fJA2oGzBmej6dv1Xilk)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain (e.g. your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Project ID (e.g. skillverify-platform)
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket (e.g. your-project.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Firebase Messaging Sender ID (Project Number, e.g. 662550364882)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_project_number

# Firebase Web App ID (e.g. 1:662550364882:web:6a558d4826731328d5630b)
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# Optional: Firebase Realtime Database URL (if enabled)
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# Optional: Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# CRITICAL FIREBASE CONSOLE CHECKLIST FOR GOOGLE AUTH:
# ------------------------------------------------------------------------------
# 1. Go to Firebase Console -> Build -> Authentication -> Sign-in method
# 2. Click "Google" under Additional providers -> Toggle "Enable"
# 3. Set "Project support email" to your email address (e.g., sanyamvij1226@gmail.com)
# 4. Click "Save"
# 5. Go to Authentication -> Settings tab -> Authorized Domains
# 6. Ensure the following domains are added:
#    - localhost
#    - skillverify-app.vercel.app
#    - skillverify-platform.firebaseapp.com
# ==============================================================================
