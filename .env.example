# ==============================================================================
# SkillVerify Master Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` or set these in your hosting platform (Vercel / Cloud).
#
# QUICK START FOR GOOGLE AUTHENTICATION:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select / Create project: `skillverify-platform`
# 3. Enable Authentication -> Sign-in Method -> Google (Set support email and Save)
# 4. Settings -> Authorized Domains -> Add `skillverify-app.vercel.app` & `localhost`
# 5. Project Settings -> General -> Your apps -> Web app -> Copy config values below:
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT FIREBASE AUTH CONFIGURATION (Prefix: VITE_)
# ------------------------------------------------------------------------------
# Web API Key from Firebase Console (e.g. AIzaSyDOx6O9VkBWsrz0fJA2oGzBmej6dv1Xilk)
VITE_FIREBASE_API_KEY=AIzaSyDOx6O9VkBWsrz0fJA2oGzBmej6dv1Xilk

# Firebase Auth Domain (e.g. skillverify-platform.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=skillverify-platform.firebaseapp.com

# Firebase Project ID (e.g. skillverify-platform)
VITE_FIREBASE_PROJECT_ID=skillverify-platform

# Firebase Cloud Storage Bucket (e.g. skillverify-platform.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=skillverify-platform.firebasestorage.app

# Firebase Messaging Sender ID (Project Number, e.g. 662550364882)
VITE_FIREBASE_MESSAGING_SENDER_ID=662550364882

# Firebase Web App ID (e.g. 1:662550364882:web:6a558d4826731328d5630b)
VITE_FIREBASE_APP_ID=1:662550364882:web:6a558d4826731328d5630b

# Optional: Realtime Database URL
VITE_FIREBASE_DATABASE_URL=

# Optional: Google Analytics Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=

# Client API Base URL (Leave empty in production so it uses relative `/api` on Vercel)
# For local dev: http://localhost:6970
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND API & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Port for local backend API server
PORT=6970

# PostgreSQL database connection (e.g. Neon serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret Keys for session management (Minimum 32 characters each)
JWT_SECRET=skill_verify_jwt_access_token_secret_key_32_characters_minimum
JWT_REFRESH_SECRET=skill_verify_jwt_refresh_token_secret_key_32_characters_minimum

# Node environment ('development' or 'production')
NODE_ENV=production

# Local file upload directory (Automatically uses /tmp on Vercel serverless)
UPLOAD_DIR=./uploads

# OpenAI API Key (For AI question generation & answer scoring)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. FIREBASE CONSOLE CHECKLIST TO MAKE GOOGLE AUTH WORK:
# ------------------------------------------------------------------------------
# 1. Sign-in Method:
#    - Navigate to: Firebase Console -> Build -> Authentication -> Sign-in method
#    - Under "Sign-in providers", click "Google" -> Click "Enable"
#    - Choose "Project support email" (your email) -> Click "Save"
#
# 2. Authorized Domains:
#    - Navigate to: Authentication -> Settings tab -> "Authorized domains"
#    - Click "Add domain" and add:
#        * localhost
#        * skillverify-app.vercel.app
#        * skillverify-platform.firebaseapp.com
# ==============================================================================
